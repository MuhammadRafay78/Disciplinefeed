{
  "name": "disciplinefeed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute disciplinefeed-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute disciplinefeed-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "check:client": "node --check public/app.js && node --check public/sw.js && node --check public/prefs.js"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
